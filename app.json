{
  "expo": {
    "name": "StitchFlow",
    "slug": "stitchflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stitchflow",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F3EF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stitchflow.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F4F3EF"
      },
      "package": "com.stitchflow.app",
      "permissions": [
        "CAMERA",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "StitchFlow needs camera access to scan garment barcodes and QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "backgroundColor": "#F4F3EF",
          "dark": {
            "backgroundColor": "#111215"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true
  }
}
