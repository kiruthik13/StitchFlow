{
  "expo": {
    "name": "StitchFlow",
    "slug": "stitchflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "scheme": "stitchflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stitchflow.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/icons/adaptive-icon-background.png",
        "monochromeImage": "./assets/icons/monochrome-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.stitchflow.app",
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/withStitchFlowBarcodeDecoder",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/monochrome-icon.png",
          "color": "#4469B1"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "StitchFlow needs camera access to scan garment barcodes and QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash-icon.png",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash/splash-icon-dark.png",
            "backgroundColor": "#11161E"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2df35e37-7a91-4844-b66a-cc9549f80838"
      }
    }
  }
}
